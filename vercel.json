{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/logo.png", "dest": "/public/logo.png" },
    { "src": "/sahan.png", "dest": "/public/sahan.png" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/about", "dest": "/public/about.html" },
    { "src": "/projects", "dest": "/public/projects.html" },
    { "src": "/project", "dest": "/public/project.html" },
    { "src": "/project/(.*)", "dest": "/public/project.html" },
    { "src": "/contact", "dest": "/public/contact.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/public/404.html" }
  ]
}
